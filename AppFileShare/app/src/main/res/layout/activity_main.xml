<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AppFileShare"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/warningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="未加密学习原型，请不要传输敏感文件" />

        <TextView
            android:id="@+id/localNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/advertiseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="广播：未开启" />

        <TextView
            android:id="@+id/bleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="蓝牙：未连接" />

        <TextView
            android:id="@+id/p2pText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P2P：未连接" />

        <TextView
            android:id="@+id/peerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前没有连接 Windows 电脑" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启设备发现" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止发现" />

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="断开连接" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择文件发送" />

        <TextView
            android:id="@+id/transferText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="当前没有传输" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/speedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/cancelSendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="取消发送" />

        <Button
            android:id="@+id/cancelReceiveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="取消接收" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
